{
  "name": "dsh-conversation-trash",
  "version": "0.2.0",
  "description": "Recycle bin for DeepSeek Harness conversations: move a session to trash from the sidebar, undo for 8 seconds, restore or purge later. / DSH 对话回收站：侧边栏移入回收站、8 秒内撤销、随时恢复或彻底删除。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "session",
    "trash",
    "recycle-bin"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/client-shape.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wusoudiaowei/dsh-conversation-trash.git"
  },
  "homepage": "https://github.com/wusoudiaowei/dsh-conversation-trash#readme",
  "bugs": {
    "url": "https://github.com/wusoudiaowei/dsh-conversation-trash/issues"
  }
}
